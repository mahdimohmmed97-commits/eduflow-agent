# Demo default. none uses the local template and calls no model.
# Later, set openai or anthropic and fill only that provider's key.
# Leave this as none for the public demo.
AI_PROVIDER=none

# Used only when AI_PROVIDER=openai, or when AI_PROVIDER is empty and this key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only when AI_PROVIDER=anthropic. Confirm the model id before enabling it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
