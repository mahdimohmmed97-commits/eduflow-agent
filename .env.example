# Demo default. none uses the checked local templates and calls no model.
# Leave this as none for the public demo. A key alone never turns a provider on:
# a provider is used only when AI_PROVIDER names it AND that provider's key is set on the server.
AI_PROVIDER=none

# Used only when AI_PROVIDER=openai. Model ids checked against OpenAI docs on 2026-11-26.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: none | low | medium | high | max (gpt-6.2-sol rejects none). Empty = model default.
OPENAI_REASONING_EFFORT=
# Ceiling for reasoning tokens + the JSON answer (reasoning is billed as output; only used tokens are billed).
OPENAI_MAX_COMPLETION_TOKENS=16000

# Used only when AI_PROVIDER=anthropic. claude-sonnet-4-5 is deprecated; ids checked on 2026-11-26.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: low | medium | high | max. Empty = model default.
ANTHROPIC_EFFORT=
# Ceiling for thinking + text (thinking is billed as output; only used tokens are billed).
ANTHROPIC_MAX_TOKENS=8000

# Server-side provider timeout in ms (5000-60000).
AI_TIMEOUT_MS=30000
