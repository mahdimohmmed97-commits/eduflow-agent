{
  "name": "eduflow-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:mock": "tsx eval/src/run.ts --provider mock",
    "eval:mock-unsafe": "tsx eval/src/run.ts --provider mock-unsafe",
    "eval:template": "tsx eval/src/run.ts --provider template",
    "eval:probes": "tsx eval/src/probes.ts",
    "eval:heldout": "tsx eval/src/heldout.ts",
    "eval:postfix": "tsx eval/src/postfix.ts",
    "eval:cost": "tsx eval/src/cost.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
